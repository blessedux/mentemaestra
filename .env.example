# Supabase (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only service role (required for SessionOrchestrator writes; never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site origin for auth redirects (magic link / Google OAuth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel AI SDK / OpenAI-compatible provider (used by ConversationRuntime)
OPENAI_API_KEY=sk-...
# Optional model id (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
